{
  "name": "rust-c64-emulator",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A cycle-exact and accelerated modern Commodore 64 emulator powered by Rust and WebAssembly.",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "license": "MIT",
  "author": "JamesLinYJ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rust:fmt": "cargo fmt --all -- --check",
    "rust:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --workspace --all-features",
    "check:rust": "npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "wasm:build:web": "wasm-pack build crates/c64-wasm --release --target web --out-dir ../../generated/wasm/web --out-name c64_vm",
    "wasm:build:node": "wasm-pack build crates/c64-wasm --release --target nodejs --out-dir ../../generated/wasm/node --out-name c64_vm",
    "wasm:build": "npm run wasm:build:web && npm run wasm:build:node",
    "verify:wasm": "npm run wasm:build && node --import tsx tools/verifyWasm.ts",
    "benchmark:emulation": "node --import tsx tools/benchmarkEmulation.ts",
    "benchmark:real": "node --import tsx tools/benchmarkRealWorkloads.ts",
    "generate:cpu-reference": "node --import tsx tools/generateCpuSingleStepFixture.ts",
    "generate:rust-cpu": "node --import tsx tools/generateRustCpuMetadata.ts",
    "verify:rust-cpu-metadata": "node --import tsx tools/generateRustCpuMetadata.ts --check",
    "generate:rust-sid": "node --import tsx tools/generateRustSidWaveforms.ts",
    "verify:rust-sid-waveforms": "node --import tsx tools/generateRustSidWaveforms.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:cpu": "node --import tsx tools/verifyCpuReference.ts && cargo run --quiet --release --locked -p c64-core --example klaus_6502 -- output/reference/6502_functional_test.bin",
    "verify:cpu-single-step": "node --import tsx tools/verifyCpuSingleStepReference.ts",
    "verify:cpu-rdy-store": "node --import tsx tools/verifyCpuRdyStoreReference.ts",
    "verify:cpu-port": "node --import tsx tools/verifyCpuPortReference.ts && cargo run --quiet --locked -p c64-core --example vice_cpu_port -- output/reference/cpuport-test1.prg",
    "verify:cartridge": "node --import tsx tools/verifyCartridgeReference.ts",
    "verify:easyflash": "node --import tsx tools/verifyEasyFlashReference.ts",
    "verify:cia": "node --import tsx tools/verifyCiaReference.ts",
    "verify:cia:new": "node --import tsx tools/verifyCiaReference.ts --new-cia",
    "verify:cia:nmi": "node --import tsx tools/verifyCiaReference.ts --nmi",
    "verify:cia:nmi:new": "node --import tsx tools/verifyCiaReference.ts --nmi --new-cia",
    "verify:cia:irqnmi": "node --import tsx tools/verifyCiaReference.ts --irqnmi --new-cia",
    "verify:cia:icr-rmw": "node --import tsx tools/verifyCiaIcrRmwReference.ts",
    "verify:cia:timer-cascade": "node --import tsx tools/verifyCiaTimerCascadeReference.ts",
    "verify:cia:timer-icr": "node --import tsx tools/verifyCiaTimerIcrReference.ts",
    "verify:cia:timer-output": "node --import tsx tools/verifyCiaTimerOutputReference.ts",
    "verify:cia:tod": "node --import tsx tools/verifyCiaTodReference.ts",
    "verify:cia:tod-alarm": "node --import tsx tools/verifyCiaTodReference.ts --alarm-cond-only",
    "verify:cia:tod-invalid": "node --import tsx tools/verifyCiaTodReference.ts --fix-tsec-only",
    "verify:cia:serial": "node --import tsx tools/verifyCiaSerialReferences.ts",
    "verify:cia:ports": "node --import tsx tools/verifyCiaPortReference.ts",
    "verify:cia:rust-differential": "node --import tsx tools/verifyRustCiaDifferential.ts",
    "verify:via": "node --import tsx tools/verifyMos6522Reference.ts",
    "verify:via:rust-differential": "node --import tsx tools/verifyRustMos6522Differential.ts",
    "verify:drive:gcr:rust-differential": "node --import tsx tools/verifyRustDrive1541GcrDifferential.ts",
    "verify:drive:d64-gcr:rust-differential": "node --import tsx tools/verifyRustD64GcrDifferential.ts",
    "verify:drive:g64:rust-differential": "node --import tsx tools/verifyRustG64Differential.ts",
    "verify:drive:mechanism:rust-differential": "node --import tsx tools/verifyRustDrive1541MechanismDifferential.ts",
    "verify:drive": "node --import tsx tools/verifyDrive1541Reference.ts",
    "verify:drive:iec-delay": "node --import tsx tools/verifyDrive1541Reference.ts --iec-delay-only",
    "verify:drive:write-protect": "node --import tsx tools/verifyDrive1541Reference.ts --write-protect-only",
    "verify:drive:disk-change": "node --import tsx tools/verifyDrive1541Reference.ts --disk-change-only",
    "verify:drive:hls": "node --import tsx tools/verifyDrive1541Reference.ts --hls-only",
    "verify:tape": "node --import tsx tools/verifyDatasetteReference.ts",
    "verify:vic": "node --import tsx tools/verifyVicReference.ts",
    "verify:vic:rust": "node --import tsx tools/verifyRustVicReference.ts",
    "verify:vic:rust-fetch-differential": "node --import tsx tools/verifyRustVicFetchDifferential.ts",
    "verify:vic:rust-device-differential": "node --import tsx tools/verifyRustVicDeviceDifferential.ts",
    "verify:vic:rust-pixel-differential": "node --import tsx tools/verifyRustVicPixelDifferential.ts",
    "verify:vic:rust-differential": "node --import tsx tools/verifyRustVicTimingDifferential.ts",
    "verify:vic:sprites": "node --import tsx tools/verifyVicSpriteReference.ts",
    "verify:sid": "node --import tsx tools/verifySidReference.ts",
    "verify:sid:rust-envelope-differential": "node --import tsx tools/verifyRustSidEnvelopeDifferential.ts",
    "verify:sid:rust-device-differential": "node --import tsx tools/verifyRustSidDeviceDifferential.ts",
    "verify:sid:rust-filter-differential": "node --import tsx tools/verifyRustSidFilterDifferential.ts",
    "verify:sid:rust-oscillator-differential": "node --import tsx tools/verifyRustSidOscillatorDifferential.ts",
    "verify:sid:rust-noise-writeback": "node --import tsx tools/verifyRustSidNoiseWritebackReference.ts",
    "verify:sid:noise-writeback": "node --import tsx tools/verifySidNoiseWritebackReference.ts",
    "verify:prg-autostart": "node --import tsx tools/verifyPrgAutostartReference.ts",
    "verify:programs": "node --import tsx tools/verifyBundledPrograms.ts",
    "verify:browser": "node --import tsx tools/verifyBrowser.ts",
    "verify:reference": "npm run verify:cpu && npm run verify:cpu-single-step && npm run verify:cpu-rdy-store && npm run verify:cpu-port && npm run verify:cartridge && npm run verify:easyflash && npm run verify:cia && npm run verify:cia:new && npm run verify:cia:nmi && npm run verify:cia:nmi:new && npm run verify:cia:irqnmi && npm run verify:cia:icr-rmw && npm run verify:cia:timer-cascade && npm run verify:cia:timer-icr && npm run verify:cia:timer-output && npm run verify:cia:tod && npm run verify:cia:serial && npm run verify:cia:ports && npm run verify:cia:rust-differential && npm run verify:via && npm run verify:via:rust-differential && npm run verify:tape && npm run verify:drive:gcr:rust-differential && npm run verify:drive:d64-gcr:rust-differential && npm run verify:drive:g64:rust-differential && npm run verify:drive:mechanism:rust-differential && npm run verify:drive && npm run verify:vic && npm run verify:vic:rust && npm run verify:vic:rust-differential && npm run verify:vic:rust-fetch-differential && npm run verify:vic:rust-pixel-differential && npm run verify:vic:rust-device-differential && npm run verify:vic:sprites && npm run verify:sid && npm run verify:sid:rust-envelope-differential && npm run verify:sid:rust-oscillator-differential && npm run verify:sid:rust-filter-differential && npm run verify:sid:rust-device-differential && npm run verify:sid:rust-noise-writeback && npm run verify:sid:noise-writeback && npm run verify:prg-autostart && npm run verify:programs",
    "check:ts": "npm run typecheck && npm run lint && npm run test && npm run build",
    "check": "npm run check:rust && npm run check:ts"
  },
  "dependencies": {
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fast-check": "^4.9.0",
    "fflate": "0.8.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.5",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
